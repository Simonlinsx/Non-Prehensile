+
+  // Read-only counterfactual diagnostic: same solved current-location plan,
+  // same fine LCS and gains, both reference interpolators. Neither trajectory
+  // replaces the plan, cost, mode, or control selected above.
+  if (const char* audit = std::getenv("PUSH_ANYTHING_DIAGNOSTIC_PD_COMPARE");
+      audit != nullptr && std::string(audit) == "1") {
+    const auto& solved = c3_objects.at(SampleIndex::kCurrentLocation);
+    const LCS coarse = solved->GetLCS();
+    const LCS& fine = lcs_candidates_for_cost.at(SampleIndex::kCurrentLocation);
+    const auto full = solved->GetFullSolution();
+    vector<VectorXd> x, u, lambda;
+    for (const auto& z : full) {
+      x.push_back(z.segment(0, n_x_));
+      lambda.push_back(z.segment(n_x_, n_lambda_));
+      u.push_back(z.segment(n_x_ + n_lambda_, n_u_));
+    }
+    x.push_back(coarse.A().back() * x.back() + coarse.B().back() * u.back() +
