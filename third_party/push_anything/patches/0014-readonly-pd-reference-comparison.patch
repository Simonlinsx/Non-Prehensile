+    auto config = c3::LCSSimulateConfig();
+    config.regularized = true;
+    config.min_exp = -8;
+    const auto zoh = TrajectoryEvaluator::SimulatePDControlWithLCS(
+        x, u, Kp_for_cost_, Kd_for_cost_, coarse, fine,
+        !force_tracking_disabled, config);
+    const int rate = TrajectoryEvaluator::CheckCoarseAndFineLCSCompatibility(coarse, fine);
+    const auto foh = SimulateFOHPDRollout(
+        x, u, Kp_for_cost_, Kd_for_cost_, 3 + 7 * controller_params_.num_objects,
+        coarse.dt(), rate, !force_tracking_disabled,
+        [&](const VectorXd& state, const VectorXd& input) {
+          return fine.Simulate(state, input, config);
+        });
+    std::ostringstream record;
+    record << std::setprecision(17)
+           << "C3_PD_REFERENCE_COMPARISON {\"utime_us\":"
+           << static_cast<int64_t>(context.get_time() * 1e6)
+           << ",\"dt_s\":" << coarse.dt()
+           << ",\"force_tracking_enabled\":" << (!force_tracking_disabled ? "true" : "false");
+    const auto write_states = [&](const char* key, const vector<VectorXd>& states) {
+      record << ",\"" << key << "\":[";
+      for (int k = 0; k < static_cast<int>(states.size()); ++k) {
+        if (k) record << ',';
+        record << '[';
+        for (int j = 0; j < states[k].size(); ++j) {
+          if (j) record << ',';
+          record << states[k][j];
+        }
+        record << ']';
+      }
+      record << ']';
+    };
+    write_states("raw_states", x);
+    write_states("zoh_states", zoh.first);
+    write_states("foh_states", foh.first);
+    record << '}';
+    std::cout << record.str() << std::endl;
+  }
 
