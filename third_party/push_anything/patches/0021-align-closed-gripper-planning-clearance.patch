+double SamplingC3Controller::SemanticPlanningClearance() const {
+  const double requested = controller_params_.semantic_guard_clearance.value_or(.025);
+  if (!controller_params_.closed_gripper_collision_meshes.has_value()) return requested;
+  // Closed fingers execute with the staged high-rate stop distance. Rejecting
+  // only the smaller point-proxy clearance admits plans the executor must hold.
+  return std::max(requested,
+      controller_params_.semantic_guard_stop_distance.value_or(requested + .010));
+}
