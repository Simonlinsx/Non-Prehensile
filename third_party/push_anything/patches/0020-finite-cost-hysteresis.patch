diff --git a/systems/controllers/finite_cost_hysteresis.h b/systems/controllers/finite_cost_hysteresis.h
new file mode 100644
--- /dev/null
+++ b/systems/controllers/finite_cost_hysteresis.h
@@ -0,0 +1,24 @@
+#pragma once
+#include <cmath>
+
+namespace dairlib {
+// Preserve the original arithmetic for finite costs. Invalid predictions
+// cannot beat a finite candidate, or become eligible by adding hysteresis.
+inline bool CostImprovesWithHysteresis(double current, double candidate,
+                                       double absolute, double fraction,
+                                       bool relative) {
+  if (!std::isfinite(candidate)) return false;
+  if (!std::isfinite(current)) return true;
+  return relative ? current > candidate + fraction * current
+                  : current > candidate + absolute;
+}
+
+inline double RepositionCostWithHysteresis(double candidate, double previous,
+                                           double absolute, double fraction,
+                                           bool relative) {
+  if (!relative) return candidate + absolute;
+  // There is no finite cost scale for an invalid previous target. Applying
+  // its infinite/NaN relative penalty would invalidate a valid new target.
+  return std::isfinite(previous) ? candidate + fraction * previous : candidate;
+}
+}  // namespace dairlib
