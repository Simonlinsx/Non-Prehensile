diff --git a/examples/sampling_c3/monitor_push_anything_baseline.py b/examples/sampling_c3/monitor_push_anything_baseline.py
new file mode 100644
index 0000000..fc5c2a7
--- /dev/null
+++ b/examples/sampling_c3/monitor_push_anything_baseline.py
@@ -0,0 +1,274 @@
+#!/usr/bin/env python3
+"""Monitor Push Anything's online debug channel and apply a pose gate."""
+
+import argparse
+import bisect
+import csv
+import json
+import math
+import time
+from pathlib import Path
+
+import lcm
+
+from dairlib import (
+    lcmt_c3_state,
+    lcmt_sampling_c3_debug,
+    lcmt_timestamped_saved_traj,
+)
+
+
+def parse_args():
+  parser = argparse.ArgumentParser(description=__doc__)
+  parser.add_argument("--output_dir", type=Path, required=True)
+  parser.add_argument("--timeout_s", type=float, default=180.0)
+  parser.add_argument("--position_threshold_m", type=float, default=0.02)
+  parser.add_argument("--rotation_threshold_rad", type=float, default=0.10)
+  parser.add_argument("--dwell_messages", type=int, default=5)
+  parser.add_argument("--channel", default="SAMPLING_C3_DEBUG")
+  parser.add_argument("--actual_channel", default="C3_ACTUAL")
+  parser.add_argument("--sample_channel", default="SAMPLE_LOCATIONS")
+  parser.add_argument(
+      "--tracking_channel", default="TRACKING_TRAJECTORY_ACTOR")
+  parser.add_argument(
+      "--lcm_url", default="tcpq://127.0.0.1:7700")
+  return parser.parse_args()
+
+
+def main():
+  args = parse_args()
+  if args.timeout_s <= 0 or args.dwell_messages <= 0:
+    raise ValueError("timeout and dwell must be positive")
+
+  args.output_dir.mkdir(parents=True, exist_ok=True)
+  csv_path = args.output_dir / "sampling_c3_debug.csv"
+  summary_path = args.output_dir / "acceptance.json"
+  start = time.monotonic()
+  state = {
+      "messages": 0,
+      "consecutive_within_gate": 0,
+      "max_consecutive_within_gate": 0,
+      "accepted": False,
+      "first_message_s": None,
+      "accepted_at_s": None,
+      "initial_position_error_m": None,
+      "initial_rotation_error_rad": None,
+      "final_position_error_m": None,
+      "final_rotation_error_rad": None,
+      "best_position_error_m": math.inf,
+      "best_rotation_error_rad": math.inf,
+      "pose_tracking_messages": 0,
+      "c3_mode_messages": 0,
+      "final_ee_position_m": None,
+      "final_object_quaternion_wxyz": None,
+      "final_object_position_m": None,
+      "final_reposition_target_m": None,
+      "tracking_trajectory_messages": 0,
+      "max_tracking_error_m": 0.0,
+      "max_command_step_m": 0.0,
+  }
+  latest_actual = {"state": None}
+  latest_samples = {"locations": None}
+  latest_tracking = {"trajectory": None}
+  previous_command = {"position": None}
+
+  with csv_path.open("w", newline="", encoding="utf-8") as csv_file:
+    writer = csv.writer(csv_file)
+    writer.writerow([
+        "wall_time_s", "message_utime", "position_error_m",
+        "rotation_error_rad", "within_gate", "consecutive_within_gate",
+        "is_c3_mode", "in_pose_tracking_mode", "mode_switch_reason",
+        "source_of_pursued_target", "ee_x_m", "ee_y_m", "ee_z_m",
+        "object_qw", "object_qx", "object_qy", "object_qz",
+        "object_x_m", "object_y_m", "object_z_m",
+        "reposition_target_x_m", "reposition_target_y_m",
+        "reposition_target_z_m",
+        "command_x_m", "command_y_m", "command_z_m",
+        "command_start_time_s", "command_end_time_s",
+        "command_message_utime", "tracking_error_m", "command_step_m",
+    ])
+
+    def handle_actual(_channel, data):
+      msg = lcmt_c3_state.decode(data)
+      latest_actual["state"] = list(msg.state)
+
+    def handle_samples(_channel, data):
+      msg = lcmt_timestamped_saved_traj.decode(data)
+      for trajectory in msg.saved_traj.trajectories:
+        if trajectory.trajectory_name != "sample_locations":
+          continue
+        latest_samples["locations"] = [
+            [trajectory.datapoints[row][column] for row in range(3)]
+            for column in range(trajectory.num_points)
+        ]
+        break
+
+    def handle_tracking(_channel, data):
+      msg = lcmt_timestamped_saved_traj.decode(data)
+      for trajectory in msg.saved_traj.trajectories:
+        if trajectory.trajectory_name != "end_effector_position_target":
+          continue
+        if trajectory.num_points <= 0 or len(trajectory.time_vec) <= 0:
+          continue
+        latest_tracking["trajectory"] = {
+            "message_utime": int(msg.utime),
+            "times": [float(value) for value in trajectory.time_vec],
+            "points": [
+                [float(trajectory.datapoints[row][column]) for row in range(3)]
+                for column in range(trajectory.num_points)
+            ],
+        }
+        state["tracking_trajectory_messages"] += 1
+        break
+
+    def evaluate_tracking_position(query_time_s):
+      trajectory = latest_tracking["trajectory"]
+      if trajectory is None:
+        return None
+      times = trajectory["times"]
+      points = trajectory["points"]
+      if query_time_s <= times[0]:
+        return points[0]
+      if query_time_s >= times[-1]:
+        return points[-1]
+      right = bisect.bisect_right(times, query_time_s)
+      left = right - 1
+      duration = times[right] - times[left]
+      alpha = 0.0 if duration <= 0 else (query_time_s - times[left]) / duration
+      return [
+          points[left][axis] + alpha * (points[right][axis] - points[left][axis])
+          for axis in range(3)
+      ]
+
+    def handle_debug(_channel, data):
+      msg = lcmt_sampling_c3_debug.decode(data)
+      elapsed = time.monotonic() - start
+      pos = float(msg.current_pos_error)
+      rot = float(msg.current_rot_error)
+      within = (
+          math.isfinite(pos) and math.isfinite(rot)
+          and pos < args.position_threshold_m
+          and rot < args.rotation_threshold_rad)
+
+      state["messages"] += 1
+      if state["first_message_s"] is None:
+        state["first_message_s"] = elapsed
+        state["initial_position_error_m"] = pos
+        state["initial_rotation_error_rad"] = rot
+      state["final_position_error_m"] = pos
+      state["final_rotation_error_rad"] = rot
+      state["best_position_error_m"] = min(state["best_position_error_m"], pos)
+      state["best_rotation_error_rad"] = min(state["best_rotation_error_rad"], rot)
+      state["pose_tracking_messages"] += int(msg.in_pose_tracking_mode)
+      state["c3_mode_messages"] += int(msg.is_c3_mode)
+      state["consecutive_within_gate"] = (
+          state["consecutive_within_gate"] + 1 if within else 0)
+      state["max_consecutive_within_gate"] = max(
+          state["max_consecutive_within_gate"],
+          state["consecutive_within_gate"])
+      if state["consecutive_within_gate"] >= args.dwell_messages:
+        state["accepted"] = True
+        state["accepted_at_s"] = elapsed
+
+      actual = latest_actual["state"]
+      if actual is not None and len(actual) >= 10:
+        ee_position = actual[0:3]
+        object_quaternion = actual[3:7]
+        object_position = actual[7:10]
+        state["final_ee_position_m"] = ee_position
+        state["final_object_quaternion_wxyz"] = object_quaternion
+        state["final_object_position_m"] = object_position
+      else:
+        ee_position = [""] * 3
+        object_quaternion = [""] * 4
+        object_position = [""] * 3
+
+      samples = latest_samples["locations"]
+      # Index 0 is the measured EE and index 1 is the retained repositioning
+      # target.  This is the actionable target whenever the debug source is
+      # kPrevious; otherwise leave it blank instead of guessing through the
+      # controller's hysteresis and buffer logic.
+      if msg.source_of_pursued_target == 1 and samples is not None and len(samples) > 1:
+        reposition_target = samples[1]
+        state["final_reposition_target_m"] = reposition_target
+      else:
+        reposition_target = [""] * 3
+
+      trajectory = latest_tracking["trajectory"]
+      command_position = evaluate_tracking_position(float(msg.utime) / 1e6)
+      tracking_error = ""
+      command_step = ""
+      command_start_time = ""
+      command_end_time = ""
+      command_message_utime = ""
+      if trajectory is not None:
+        command_start_time = trajectory["times"][0]
+        command_end_time = trajectory["times"][-1]
+        command_message_utime = trajectory["message_utime"]
+      if command_position is not None:
+        if actual is not None and len(actual) >= 3:
+          tracking_error = math.sqrt(sum(
+              (float(actual[axis]) - command_position[axis]) ** 2
+              for axis in range(3)))
+          state["max_tracking_error_m"] = max(
+              state["max_tracking_error_m"], tracking_error)
+        if previous_command["position"] is not None:
+          command_step = math.sqrt(sum(
+              (previous_command["position"][axis] - command_position[axis]) ** 2
+              for axis in range(3)))
+          state["max_command_step_m"] = max(
+              state["max_command_step_m"], command_step)
+        previous_command["position"] = command_position
+      else:
+        command_position = [""] * 3
+
+      writer.writerow([
+          f"{elapsed:.6f}", msg.utime, f"{pos:.9f}", f"{rot:.9f}",
+          int(within), state["consecutive_within_gate"],
+          int(msg.is_c3_mode), int(msg.in_pose_tracking_mode),
+          msg.mode_switch_reason, msg.source_of_pursued_target,
+          *ee_position, *object_quaternion, *object_position,
+          *reposition_target,
+          *command_position, command_start_time, command_end_time,
+          command_message_utime, tracking_error, command_step,
+      ])
+      csv_file.flush()
+
+    lcm_handle = lcm.LCM(args.lcm_url)
+    subscriptions = [
+        lcm_handle.subscribe(args.channel, handle_debug),
+        lcm_handle.subscribe(args.actual_channel, handle_actual),
+        lcm_handle.subscribe(args.sample_channel, handle_samples),
+        lcm_handle.subscribe(args.tracking_channel, handle_tracking),
+    ]
+    try:
+      while (not state["accepted"]
+             and time.monotonic() - start < args.timeout_s):
+        lcm_handle.handle_timeout(100)
+    finally:
+      for subscription in subscriptions:
+        lcm_handle.unsubscribe(subscription)
+
+  state["elapsed_s"] = time.monotonic() - start
+  state["timed_out"] = not state["accepted"]
+  state["channel"] = args.channel
+  state["actual_channel"] = args.actual_channel
+  state["sample_channel"] = args.sample_channel
+  state["tracking_channel"] = args.tracking_channel
+  state["lcm_url"] = args.lcm_url
+  state["position_threshold_m"] = args.position_threshold_m
+  state["rotation_threshold_rad"] = args.rotation_threshold_rad
+  state["dwell_messages_required"] = args.dwell_messages
+  state["best_position_error_m"] = (
+      None if math.isinf(state["best_position_error_m"])
+      else state["best_position_error_m"])
+  state["best_rotation_error_rad"] = (
+      None if math.isinf(state["best_rotation_error_rad"])
+      else state["best_rotation_error_rad"])
+  summary_path.write_text(json.dumps(state, indent=2) + "\n", encoding="utf-8")
+  print(json.dumps(state, indent=2))
+  return 0 if state["accepted"] else 1
+
+
+if __name__ == "__main__":
+  raise SystemExit(main())
