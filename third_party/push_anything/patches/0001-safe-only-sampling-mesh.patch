+
+// Squared Euclidean distance from p to a triangle.  This is the region-test
+// construction from Real-Time Collision Detection and avoids depending on a
+// second SceneGraph merely to carry semantic, non-physical geometry.
+double PointTriangleSquaredDistance(const Vector3d& p, const Face& face) {
+  const Vector3d& a = face.v[0];
+  const Vector3d& b = face.v[1];
+  const Vector3d& c = face.v[2];
+  const Vector3d ab = b - a;
+  const Vector3d ac = c - a;
+  const Vector3d ap = p - a;
+  const double d1 = ab.dot(ap);
+  const double d2 = ac.dot(ap);
+  if (d1 <= 0.0 && d2 <= 0.0) return ap.squaredNorm();
+
+  const Vector3d bp = p - b;
+  const double d3 = ab.dot(bp);
+  const double d4 = ac.dot(bp);
+  if (d3 >= 0.0 && d4 <= d3) return bp.squaredNorm();
+
+  const double vc = d1 * d4 - d3 * d2;
+  if (vc <= 0.0 && d1 >= 0.0 && d3 <= 0.0) {
+    const double v = d1 / (d1 - d3);
+    return (p - (a + v * ab)).squaredNorm();
+  }
+
+  const Vector3d cp = p - c;
+  const double d5 = ab.dot(cp);
+  const double d6 = ac.dot(cp);
+  if (d6 >= 0.0 && d5 <= d6) return cp.squaredNorm();
+
+  const double vb = d5 * d2 - d1 * d6;
+  if (vb <= 0.0 && d2 >= 0.0 && d6 <= 0.0) {
+    const double w = d2 / (d2 - d6);
+    return (p - (a + w * ac)).squaredNorm();
+  }
+
+  const double va = d3 * d6 - d5 * d4;
+  if (va <= 0.0 && (d4 - d3) >= 0.0 && (d5 - d6) >= 0.0) {
+    const double w = (d4 - d3) / ((d4 - d3) + (d5 - d6));
+    return (p - (b + w * (c - b))).squaredNorm();
+  }
+
+  const double denominator = va + vb + vc;
+  if (std::abs(denominator) < 1.0e-18) {
+    return std::min({ap.squaredNorm(), bp.squaredNorm(), cp.squaredNorm()});
+  }
+  const double inverse_denominator = 1.0 / denominator;
+  const double v = vb * inverse_denominator;
+  const double w = vc * inverse_denominator;
+  return (p - (a + ab * v + ac * w)).squaredNorm();
+}
