+namespace dairlib {
+
+// A high-rate execution shield for C1.  It runs in the OSC diagram (which is
+// driven by every Franka state message), independently of the slower C3 solve.
+// If either the measured EE center or the currently evaluated position command
+// gets too close to a protected/neutral surface, it replaces the position
+// trajectory with a measured-pose hold and zeros the feed-forward force.
+class SemanticC1TrajectoryGuard final
+    : public drake::systems::LeafSystem<double> {
+ public:
+  SemanticC1TrajectoryGuard(
+      const drake::multibody::MultibodyPlant<double>& franka_plant,
+      drake::systems::Context<double>* franka_context,
+      const std::string& end_effector_name,
+      const std::vector<std::string>& unsafe_mesh_paths,
+      double stop_distance);
+
+  const drake::systems::InputPort<double>& get_input_port_robot_state() const;
+  const drake::systems::InputPort<double>& get_input_port_position_trajectory()
+      const;
+  const drake::systems::InputPort<double>& get_input_port_force_trajectory()
+      const;
+  const drake::systems::InputPort<double>& get_input_port_object_state(
+      int object_index) const;
+
+  const drake::systems::OutputPort<double>&
+  get_output_port_position_trajectory() const;
+  const drake::systems::OutputPort<double>& get_output_port_force_trajectory()
+      const;
+
+ private:
+  bool ShouldHold(const drake::systems::Context<double>& context,
+                  Eigen::Vector3d* ee_position,
+                  Eigen::Vector3d* guard_target,
+                  double* minimum_distance) const;
+  double MinimumUnsafeSurfaceDistance(
+      const drake::systems::Context<double>& context,
+      const Eigen::Vector3d& point_world,
+      Eigen::Vector3d* closest_point_world) const;
+  void CalcPositionTrajectory(
+      const drake::systems::Context<double>& context,
+      drake::trajectories::Trajectory<double>* output) const;
+  void CalcForceTrajectory(
+      const drake::systems::Context<double>& context,
+      drake::trajectories::Trajectory<double>* output) const;
+
+  const drake::multibody::MultibodyPlant<double>& franka_plant_;
+  drake::systems::Context<double>* franka_context_;
+  std::string end_effector_name_;
+  double stop_distance_;
+  std::vector<std::vector<systems::Face>> unsafe_faces_per_object_;
+
+  drake::systems::InputPortIndex robot_state_port_;
+  drake::systems::InputPortIndex position_trajectory_port_;
+  drake::systems::InputPortIndex force_trajectory_port_;
+  std::vector<drake::systems::InputPortIndex> object_state_ports_;
+  drake::systems::OutputPortIndex position_trajectory_output_port_;
+  drake::systems::OutputPortIndex force_trajectory_output_port_;
+  mutable bool was_holding_ = false;
+};
+
+}  // namespace dairlib
