+
+using Eigen::Vector3d;
+using systems::Face;
+
+Vector3d ClosestPointOnTriangle(const Vector3d& p, const Face& face) {
+  const Vector3d& a = face.v[0];
+  const Vector3d& b = face.v[1];
+  const Vector3d& c = face.v[2];
+  const Vector3d ab = b - a;
+  const Vector3d ac = c - a;
+  const Vector3d ap = p - a;
+  const double d1 = ab.dot(ap);
+  const double d2 = ac.dot(ap);
+  if (d1 <= 0.0 && d2 <= 0.0) return a;
+
+  const Vector3d bp = p - b;
+  const double d3 = ab.dot(bp);
+  const double d4 = ac.dot(bp);
+  if (d3 >= 0.0 && d4 <= d3) return b;
+
+  const double vc = d1 * d4 - d3 * d2;
+  if (vc <= 0.0 && d1 >= 0.0 && d3 <= 0.0) {
+    const double v = d1 / (d1 - d3);
+    return a + v * ab;
+  }
+
+  const Vector3d cp = p - c;
+  const double d5 = ab.dot(cp);
+  const double d6 = ac.dot(cp);
+  if (d6 >= 0.0 && d5 <= d6) return c;
+
+  const double vb = d5 * d2 - d1 * d6;
+  if (vb <= 0.0 && d2 >= 0.0 && d6 <= 0.0) {
+    const double w = d2 / (d2 - d6);
+    return a + w * ac;
+  }
+
+  const double va = d3 * d6 - d5 * d4;
+  if (va <= 0.0 && (d4 - d3) >= 0.0 && (d5 - d6) >= 0.0) {
+    const double w = (d4 - d3) / ((d4 - d3) + (d5 - d6));
+    return b + w * (c - b);
+  }
+
+  const double denominator = va + vb + vc;
+  if (std::abs(denominator) < 1.0e-18) {
+    if (ap.squaredNorm() <= bp.squaredNorm() &&
+        ap.squaredNorm() <= cp.squaredNorm()) {
+      return a;
+    }
+    return bp.squaredNorm() <= cp.squaredNorm() ? b : c;
+  }
+  const double v = vb / denominator;
+  const double w = vc / denominator;
+  return a + v * ab + w * ac;
+}
+
+}  // namespace
+
+SemanticC1TrajectoryGuard::SemanticC1TrajectoryGuard(
+    const drake::multibody::MultibodyPlant<double>& franka_plant,
+    drake::systems::Context<double>* franka_context,
+    const std::string& end_effector_name,
+    const std::vector<std::string>& unsafe_mesh_paths, double stop_distance)
+    : franka_plant_(franka_plant),
+      franka_context_(franka_context),
+      end_effector_name_(end_effector_name),
+      stop_distance_(stop_distance) {
+  if (unsafe_mesh_paths.empty()) {
+    throw std::runtime_error("Semantic C1 guard requires unsafe meshes");
+  }
+  if (stop_distance_ <= 0.0) {
+    throw std::runtime_error("Semantic C1 guard stop distance must be positive");
+  }
+
+  for (const std::string& mesh_path : unsafe_mesh_paths) {
+    const auto mesh = drake::geometry::ReadObjToTriangleSurfaceMesh(
+        mesh_path, 1.0);
+    const auto& vertices = mesh.vertices();
+    std::vector<Face> faces;
+    faces.reserve(mesh.num_triangles());
+    for (int index = 0; index < mesh.num_triangles(); ++index) {
+      const auto triangle = mesh.triangles()[index];
+      const Vector3d v0 = vertices[triangle.vertex(0)];
+      const Vector3d v1 = vertices[triangle.vertex(1)];
+      const Vector3d v2 = vertices[triangle.vertex(2)];
+      const Vector3d cross = (v1 - v0).cross(v2 - v0);
+      const double area = 0.5 * cross.norm();
+      if (area > 1.0e-14) {
+        faces.push_back({area, cross.normalized(), {v0, v1, v2}});
+      }
+    }
+    if (faces.empty()) {
+      throw std::runtime_error("No valid unsafe faces found in " + mesh_path);
+    }
+    unsafe_faces_per_object_.push_back(std::move(faces));
+  }
+
+  robot_state_port_ =
+      this->DeclareVectorInputPort(
+              "franka_state",
+              systems::OutputVector<double>(franka_plant_.num_positions(),
+                                            franka_plant_.num_velocities(),
+                                            franka_plant_.num_actuators()))
+          .get_index();
+
+  drake::trajectories::PiecewisePolynomial<double> empty_trajectory(
+      Vector3d::Zero());
+  drake::trajectories::Trajectory<double>& trajectory_model = empty_trajectory;
+  position_trajectory_port_ =
+      this->DeclareAbstractInputPort(
+              "position_trajectory",
+              drake::Value<drake::trajectories::Trajectory<double>>(
+                  empty_trajectory))
+          .get_index();
+  force_trajectory_port_ =
+      this->DeclareAbstractInputPort(
+              "force_trajectory",
+              drake::Value<drake::trajectories::Trajectory<double>>(
+                  empty_trajectory))
+          .get_index();
+
+  for (int object_index = 0;
+       object_index < static_cast<int>(unsafe_faces_per_object_.size());
+       ++object_index) {
+    object_state_ports_.push_back(
+        this->DeclareVectorInputPort(
+                "object_state_" + std::to_string(object_index),
+                systems::StateVector<double>(7, 6))
+            .get_index());
+  }
+
+  position_trajectory_output_port_ =
+      this->DeclareAbstractOutputPort(
+              "guarded_position_trajectory", trajectory_model,
+              &SemanticC1TrajectoryGuard::CalcPositionTrajectory)
+          .get_index();
+  force_trajectory_output_port_ =
+      this->DeclareAbstractOutputPort(
+              "guarded_force_trajectory", trajectory_model,
+              &SemanticC1TrajectoryGuard::CalcForceTrajectory)
+          .get_index();
+}
+
+const drake::systems::InputPort<double>&
+SemanticC1TrajectoryGuard::get_input_port_robot_state() const {
+  return this->get_input_port(robot_state_port_);
+}
+
+const drake::systems::InputPort<double>&
+SemanticC1TrajectoryGuard::get_input_port_position_trajectory() const {
+  return this->get_input_port(position_trajectory_port_);
+}
+
+const drake::systems::InputPort<double>&
+SemanticC1TrajectoryGuard::get_input_port_force_trajectory() const {
+  return this->get_input_port(force_trajectory_port_);
+}
+
+const drake::systems::InputPort<double>&
+SemanticC1TrajectoryGuard::get_input_port_object_state(
+    int object_index) const {
+  return this->get_input_port(object_state_ports_.at(object_index));
+}
+
+const drake::systems::OutputPort<double>&
+SemanticC1TrajectoryGuard::get_output_port_position_trajectory() const {
+  return this->get_output_port(position_trajectory_output_port_);
+}
+
+const drake::systems::OutputPort<double>&
+SemanticC1TrajectoryGuard::get_output_port_force_trajectory() const {
+  return this->get_output_port(force_trajectory_output_port_);
+}
+
+double SemanticC1TrajectoryGuard::MinimumUnsafeSurfaceDistance(
+    const drake::systems::Context<double>& context,
+    const Vector3d& point_world, Vector3d* closest_point_world) const {
+  double minimum_squared_distance = std::numeric_limits<double>::infinity();
+  for (int object_index = 0;
+       object_index < static_cast<int>(unsafe_faces_per_object_.size());
+       ++object_index) {
+    const auto* object_state = dynamic_cast<const systems::StateVector<double>*>(
+        this->EvalVectorInput(context, object_state_ports_[object_index]));
+    if (object_state == nullptr) {
+      return std::numeric_limits<double>::quiet_NaN();
+    }
+    const Eigen::VectorXd positions = object_state->GetPositions();
+    Eigen::Quaterniond quaternion(positions.head<4>());
+    if (quaternion.norm() < 1.0e-12) {
+      return std::numeric_limits<double>::quiet_NaN();
+    }
+    quaternion.normalize();
+    const Vector3d point_object =
+        quaternion.inverse() * (point_world - positions.segment<3>(4));
+    for (const Face& face : unsafe_faces_per_object_[object_index]) {
+      const Vector3d closest_object = ClosestPointOnTriangle(point_object, face);
+      const double squared_distance =
+          (point_object - closest_object).squaredNorm();
+      if (squared_distance < minimum_squared_distance) {
+        minimum_squared_distance = squared_distance;
+        if (closest_point_world != nullptr) {
+          *closest_point_world =
+              quaternion * closest_object + positions.segment<3>(4);
+        }
+      }
+    }
+  }
+  return std::sqrt(std::max(0.0, minimum_squared_distance));
+}
+
+bool SemanticC1TrajectoryGuard::ShouldHold(
+    const drake::systems::Context<double>& context, Vector3d* ee_position,
+    Vector3d* guard_target, double* minimum_distance) const {
+  const auto* franka_state = dynamic_cast<const systems::OutputVector<double>*>(
+      this->EvalVectorInput(context, robot_state_port_));
+  if (franka_state == nullptr) return true;
+  multibody::SetPositionsIfNew<double>(franka_plant_,
+                                       franka_state->GetPositions(),
+                                       franka_context_);
+  *ee_position = franka_plant_
+                     .EvalBodyPoseInWorld(
+                         *franka_context_,
+                         franka_plant_.GetBodyByName(end_effector_name_))
+                     .translation();
+  Vector3d closest_unsafe_point = Vector3d::Zero();
+  const double measured_distance = MinimumUnsafeSurfaceDistance(
+      context, *ee_position, &closest_unsafe_point);
+
+  const auto& position_trajectory =
+      this->EvalAbstractInput(context, position_trajectory_port_)
+          ->get_value<drake::trajectories::Trajectory<double>>();
+  double evaluation_time = context.get_time();
+  evaluation_time = std::max(position_trajectory.start_time(),
+                             std::min(position_trajectory.end_time(),
+                                      evaluation_time));
+  const Eigen::MatrixXd commanded_value = position_trajectory.value(evaluation_time);
+  double commanded_distance = std::numeric_limits<double>::infinity();
+  if (commanded_value.rows() >= 3 && commanded_value.cols() >= 1) {
+    commanded_distance = MinimumUnsafeSurfaceDistance(
+        context, commanded_value.topRows<3>().col(0), nullptr);
+  }
+  *minimum_distance = std::min(measured_distance, commanded_distance);
+  const bool hold = !std::isfinite(*minimum_distance) ||
+                    *minimum_distance <= stop_distance_;
+  *guard_target = *ee_position;
+  if (hold && std::isfinite(measured_distance) &&
+      measured_distance <= stop_distance_) {
+    const Vector3d escape = *ee_position - closest_unsafe_point;
+    if (escape.norm() > 1.0e-9) {
+      constexpr double kRetreatMargin = 0.003;
+      *guard_target += (stop_distance_ + kRetreatMargin - measured_distance) *
+                       escape.normalized();
+    }
+  }
+  if (hold != was_holding_) {
+    std::cout << "Semantic C1 OSC guard "
+              << (hold ? "holding" : "released")
+              << "; minimum unsafe surface distance: " << *minimum_distance
+              << " m" << std::endl;
+    was_holding_ = hold;
+  }
+  return hold;
+}
+
+void SemanticC1TrajectoryGuard::CalcPositionTrajectory(
+    const drake::systems::Context<double>& context,
+    drake::trajectories::Trajectory<double>* output) const {
+  auto* result = dynamic_cast<drake::trajectories::PiecewisePolynomial<double>*>(
+      output);
+  Vector3d ee_position = Vector3d::Zero();
+  Vector3d guard_target = Vector3d::Zero();
+  double minimum_distance = 0.0;
+  if (ShouldHold(context, &ee_position, &guard_target, &minimum_distance)) {
+    *result = drake::trajectories::PiecewisePolynomial<double>(guard_target);
+    return;
+  }
+  const auto& input =
+      this->EvalAbstractInput(context, position_trajectory_port_)
+          ->get_value<drake::trajectories::Trajectory<double>>();
+  *result = *dynamic_cast<
+      const drake::trajectories::PiecewisePolynomial<double>*>(&input);
+}
+
+void SemanticC1TrajectoryGuard::CalcForceTrajectory(
+    const drake::systems::Context<double>& context,
+    drake::trajectories::Trajectory<double>* output) const {
+  auto* result = dynamic_cast<drake::trajectories::PiecewisePolynomial<double>*>(
+      output);
+  Vector3d ee_position = Vector3d::Zero();
+  Vector3d guard_target = Vector3d::Zero();
+  double minimum_distance = 0.0;
+  if (ShouldHold(context, &ee_position, &guard_target, &minimum_distance)) {
+    *result = drake::trajectories::PiecewisePolynomial<double>(
+        Vector3d::Zero());
+    return;
+  }
+  const auto& input =
+      this->EvalAbstractInput(context, force_trajectory_port_)
+          ->get_value<drake::trajectories::Trajectory<double>>();
+  *result = *dynamic_cast<
+      const drake::trajectories::PiecewisePolynomial<double>*>(&input);
+}
+
+}  // namespace dairlib
