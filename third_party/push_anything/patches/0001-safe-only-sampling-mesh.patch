+double SamplingC3Controller::MinimumUnsafeSurfaceDistance(
+    const VectorXd& x_lcs) const {
+  if (unsafe_faces_per_object_.empty()) {
+    return std::numeric_limits<double>::infinity();
+  }
+
+  double minimum_squared_distance = std::numeric_limits<double>::infinity();
+  const Vector3d ee_world = x_lcs.head<3>();
+  for (int object_index = 0;
+       object_index < static_cast<int>(unsafe_faces_per_object_.size());
+       ++object_index) {
+    const int quaternion_index = 3 + 7 * object_index;
+    const int position_index = 7 + 7 * object_index;
+    if (position_index + 2 >= n_q_) {
+      throw std::runtime_error(
+          "Semantic guard object mesh count exceeds object state count");
+    }
+    Quaterniond object_quaternion(
+        x_lcs.segment<4>(quaternion_index));
+    if (object_quaternion.norm() < 1.0e-12) {
+      // A malformed predicted orientation must fail closed.
+      return 0.0;
+    }
+    object_quaternion.normalize();
+    const Vector3d object_position = x_lcs.segment<3>(position_index);
+    const Vector3d ee_object =
+        object_quaternion.inverse() * (ee_world - object_position);
+    for (const Face& face : unsafe_faces_per_object_[object_index]) {
+      minimum_squared_distance =
+          std::min(minimum_squared_distance,
+                   PointTriangleSquaredDistance(ee_object, face));
+    }
+  }
+  return std::sqrt(std::max(0.0, minimum_squared_distance));
+}
+
+bool SamplingC3Controller::C3TrajectoryViolatesSemanticGuard(
+    const VectorXd& x_lcs, const vector<VectorXd>& x_sol,
+    double* minimum_distance) const {
+  *minimum_distance = std::numeric_limits<double>::infinity();
+  if (unsafe_faces_per_object_.empty()) return false;
+
+  const double clearance =
+      controller_params_.semantic_guard_clearance.value_or(0.025);
+  // Interpolate the linearized state trajectory between every C3 knot.  The
+  // controller is replanned frequently, but the substeps also guard the
+  // continuous trajectory sent to the downstream interpolator.
+  constexpr int kInterpolationSubsteps = 4;
+  VectorXd segment_start = x_lcs;
+  for (const VectorXd& segment_end : x_sol) {
+    for (int substep = 0; substep <= kInterpolationSubsteps; ++substep) {
+      const double alpha =
+          static_cast<double>(substep) / kInterpolationSubsteps;
+      const VectorXd interpolated =
+          (1.0 - alpha) * segment_start + alpha * segment_end;
+      const double distance = MinimumUnsafeSurfaceDistance(interpolated);
+      *minimum_distance = std::min(*minimum_distance, distance);
+      if (!std::isfinite(distance) || distance <= clearance) return true;
+    }
+    segment_start = segment_end;
+  }
+  return false;
+}
