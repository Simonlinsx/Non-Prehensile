+++ b/examples/sampling_c3/parameter_headers/sampling_c3_controller_params.h
@@ -2,0 +3,3 @@
+#include <optional>
+#include <stdexcept>
+
@@ -30,0 +34,4 @@ struct SamplingC3ControllerParams {
+  // Optional per-object meshes used only by the global surface sampler.  The
+  // complete object_models remain unchanged for dynamics and contact.  This
+  // lets a semantic planner sample from a conservative safe-only surface.
+  std::optional<std::vector<std::string>> sampling_meshes;
@@ -64,0 +72,7 @@ struct SamplingC3ControllerParams {
+    a->Visit(DRAKE_NVP(sampling_meshes));
+
+    if (sampling_meshes.has_value() && !sampling_meshes->empty() &&
+        sampling_meshes->size() != base_names.size()) {
+      throw std::runtime_error(
+          "sampling_meshes must be absent/empty or match base_names size");
+    }
