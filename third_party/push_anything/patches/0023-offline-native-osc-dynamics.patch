 int DoMain(int argc, char* argv[]) {
   gflags::ParseCommandLineFlags(&argc, &argv, true);
+  if (!FLAGS_offline_robot_dynamics_input.empty()) {
+    std::ifstream input(FLAGS_offline_robot_dynamics_input);
+    Eigen::VectorXd positions(7);
+    for (int i = 0; i < 7; ++i) DRAKE_THROW_UNLESS(bool(input >> positions[i]));
+    DRAKE_THROW_UNLESS(positions.allFinite());
+    drake::multibody::MultibodyPlant<double> model(0.0);
+    AddFrankaToPlant(&model);
+    model.Finalize();
+    auto context = model.CreateDefaultContext();
+    model.SetPositions(context.get(), positions);
+    Eigen::VectorXd gravity = -model.CalcGravityGeneralizedForces(*context);
+    Eigen::MatrixXd mass(7, 7);
+    model.CalcMassMatrix(*context, &mass);
+    auto tip = model.EvalBodyPoseInWorld(*context, model.GetBodyByName(kEndEffectorName));
+    std::cout << std::setprecision(17) << "OSC_MODEL_GRAVITY " << gravity.transpose() << std::endl;
+    std::cout << "OSC_MODEL_TIP " << tip.translation().transpose() << " "
+              << tip.rotation().ToQuaternion().coeffs().transpose() << std::endl;
+    for (int i = 0; i < 7; ++i)
+      std::cout << "OSC_MODEL_MASS_ROW " << i << " " << mass.row(i) << std::endl;
+    for (int i = 1; i < model.num_bodies(); ++i) {
+      const auto& body = model.get_body(drake::multibody::BodyIndex(i));
+      std::cout << "OSC_MODEL_BODY " << body.name() << " " << body.default_mass() << std::endl;
+    }
+    return 0;
+  }
+
   drake::lcm::DrakeLcm lcm(FLAGS_lcm_url);
 
   // Load parameters.
