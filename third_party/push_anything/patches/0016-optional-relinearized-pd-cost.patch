+// Update only the cost model. Scalar apparent inertia approximates horizontal
+// OSC response; it is not a replacement for the articulated Franka dynamics.
+std::pair<vector<VectorXd>, vector<VectorXd>>
+SamplingC3Controller::SimulateRelinearizedPDCost(
+    const vector<VectorXd>& x_plan, const vector<VectorXd>& u_plan,
+    double dt, bool track_force) const {
+  const VectorXd saved_x = plant_.GetPositionsAndVelocities(*context_);
+  const auto& body = plant_.GetBodyByName("end_effector_simple");
+  const auto& body_ad = plant_ad_.GetBodyByName("end_effector_simple");
+  const double saved_mass = body.get_mass(*context_);
+  const auto saved_mass_ad = body_ad.get_mass(*context_ad_);
+  const auto restore = [&]() {
+    UpdateContext(n_q_, n_v_, n_u_, plant_, context_, plant_ad_, context_ad_, saved_x);
+    body.SetMass(context_, saved_mass);
+    body_ad.SetMass(context_ad_, saved_mass_ad);
+  };
+  try {
+    constexpr double mass = 1.0;
+    body.SetMass(context_, mass);
+    body_ad.SetMass(context_ad_, drake::AutoDiffXd(mass));
+    VectorXd kp = VectorXd::Zero(n_x_), kd = VectorXd::Zero(n_x_);
+    kp.head<3>().setConstant(mass * 200.0);
+    kd.segment<3>(n_q_).setConstant(mass * 20.0);
+    vector<VectorXd> u;
+    for (const auto& raw : u_plan) {
+      VectorXd force = -mass * plant_.gravity_field().gravity_vector();
+      if (track_force) force -= raw;
+      u.push_back(force);
+    }
+    auto config = c3::LCSSimulateConfig();
+    config.regularized = true;
+    config.min_exp = -8;
+    const auto prediction = SimulateFOHPDRollout(
+        x_plan, u, kp, kd, n_q_, dt, sampling_c3_options_.lcs_dt_resolution, true,
+        [&](const VectorXd& state, const VectorXd& input) {
+          VectorXd current = state;
+          for (int j = 0; j < controller_params_.num_objects; ++j)
+            current.segment<4>(3 + 7 * j).normalize();
+          UpdateContext(n_q_, n_v_, n_u_, plant_, context_, plant_ad_, context_ad_, current);
+          const auto contacts = GetResolvedContactPairs(
+              plant_, *context_, contact_pairs_, sampling_c3_options_.resolve_contacts_to_for_cost,
+              sampling_c3_options_.num_friction_directions_per_contact_for_cost, false);
+          LCSFactoryOptions options = {
+              .contact_model = controller_params_.sampling_c3_options.contact_model,
+              .N = 1,
+              .dt = dt / sampling_c3_options_.lcs_dt_resolution,
+              .num_contacts = contacts.size(), .spring_stiffness = 0.0,
+              .num_friction_directions_per_contact = sampling_c3_options_.num_friction_directions_per_contact_for_cost,
+              .mu_per_contact = sampling_c3_options_.mu_for_cost,
+              .planar_normal_direction = sampling_c3_options_.planar_normal_direction};
+          const LCS fine = LCSFactory(plant_, *context_, plant_ad_, *context_ad_, contacts, options).GenerateLCS();
+          VectorXd next = fine.Simulate(current, input, config);
+          for (int j = 0; j < controller_params_.num_objects; ++j)
+            next.segment<4>(3 + 7 * j).normalize();
+          return next;
+        });
+    restore();
+    return prediction;
+  } catch (...) {
+    restore();
+    throw;
+  }
+}
