  public:
+  // Offline audit only: evaluate a supplied reference without computing or
+  // publishing a control command. Resolution is set in the audit constructor.
+  std::pair<std::vector<Eigen::VectorXd>, std::vector<Eigen::VectorXd>>
+  AuditRelinearizedPDReplay(const std::vector<Eigen::VectorXd>& x,
+                           const std::vector<Eigen::VectorXd>& u,
+                           double dt, bool track_force, bool sampled_clocks = false) const {
+    if (sampled_clocks) return AuditSampledPDReplay(x, u, dt, track_force);
+    return SimulateRelinearizedPDCost(x, u, dt, track_force);
+  }
+
+  std::pair<std::vector<Eigen::VectorXd>, std::vector<Eigen::VectorXd>>
+  AuditSampledPDReplay(const std::vector<Eigen::VectorXd>& x,
+                       const std::vector<Eigen::VectorXd>& u,
+                       double dt, bool track_force) const;
+
   explicit SamplingC3Controller(
       drake::multibody::MultibodyPlant<double>& plant,
       drake::systems::Context<double>* context,
