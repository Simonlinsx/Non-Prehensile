+std::vector<drake::geometry::SignedDistanceToPoint<double>> NonFingerPointDistances(
+    const drake::multibody::MultibodyPlant<double>& plant,
+    const drake::geometry::QueryObject<double>& query, const Eigen::Vector3d& point) {
+  auto results = query.ComputeSignedDistanceToPoint(point);
+  if (!plant.HasBodyNamed("closed_gripper_finger_0")) return results;
+  for (int i = 0; i < 2; ++i) {
+    const auto ids = plant.GetCollisionGeometriesForBody(
+        plant.GetBodyByName("closed_gripper_finger_" + std::to_string(i)));
+    results.erase(std::remove_if(results.begin(), results.end(), [&](const auto& r) {
+      return std::find(ids.begin(), ids.end(), r.id_G) != ids.end();
+    }), results.end());
+  }
+  return results;
+}
+
+// Replace the sphere's support radius with the oriented fingers' support
+// function along the sampled normal. The sampled face/direction and original
+// surface clearance are unchanged; this is a shape-dependent frame offset.
+double ClosedGripperBufferCorrection(const drake::multibody::MultibodyPlant<double>& plant,
+    const drake::systems::Context<double>& context, const Eigen::Vector3d& normal) {
+  if (!plant.HasBodyNamed("closed_gripper_finger_0")) return 0.;
+  const auto& query = plant.get_geometry_query_input_port()
+      .Eval<drake::geometry::QueryObject<double>>(context);
+  const auto& inspector = query.inspector();
+  const auto& actor = plant.GetBodyByName("end_effector_simple");
+  const auto center = plant.EvalBodyPoseInWorld(context, actor).translation();
+  const auto sphere_id = plant.GetCollisionGeometriesForBody(actor).at(0);
+  const auto& sphere = dynamic_cast<const drake::geometry::Sphere&>(inspector.GetShape(sphere_id));
+  double support = -std::numeric_limits<double>::infinity();
+  for (int i = 0; i < 2; ++i) {
+    const auto& finger = plant.GetBodyByName("closed_gripper_finger_" + std::to_string(i));
+    const auto id = plant.GetCollisionGeometriesForBody(finger).at(0);
+    const auto& convex = dynamic_cast<const drake::geometry::Convex&>(inspector.GetShape(id));
+    const auto& hull = convex.GetConvexHull();
+    const auto X = plant.EvalBodyPoseInWorld(context, finger) * inspector.GetPoseInFrame(id);
+    for (int v = 0; v < hull.num_vertices(); ++v)
+      support = std::max(support, -(X * hull.vertex(v) - center).dot(normal));
+  }
+  return support - sphere.radius();
+}
 
