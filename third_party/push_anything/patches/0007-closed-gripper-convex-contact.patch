+#pragma once
+#include <cmath>
+#include <stdexcept>
+#include <vector>
+#include "drake/geometry/shape_specification.h"
+#include "drake/multibody/plant/multibody_plant.h"
+#include "drake/multibody/tree/fixed_offset_frame.h"
+
+namespace dairlib {
+// Convexes are exported in panda_hand axes about the C3 task reference point.
+// This frame is a context parameter, not an extra optimized degree of freedom.
+inline void AddClosedGripperContactGeometry(
+    drake::multibody::MultibodyPlant<double>* plant,
+    const std::vector<std::string>& meshes) {
+  if (meshes.size() != 2) throw std::runtime_error("Expected two finger convex meshes");
+  const auto& actor = plant->GetBodyByName("end_effector_simple");
+  const auto& orientation = plant->AddFrame(
+      std::make_unique<drake::multibody::FixedOffsetFrame<double>>("closed_gripper_orientation", actor.body_frame(),
+      drake::math::RigidTransform<double>::Identity()));
+  for (int i = 0; i < 2; ++i) {
+    auto& finger = plant->AddRigidBody("closed_gripper_finger_" + std::to_string(i),
+        actor.model_instance(), drake::multibody::SpatialInertia<double>::Zero());
+    plant->WeldFrames(orientation, finger.body_frame());
+    plant->RegisterCollisionGeometry(finger,
+        drake::math::RigidTransform<double>::Identity(),
+        drake::geometry::Convex(meshes[i]), "closed_gripper_convex_" + std::to_string(i),
+        drake::multibody::CoulombFriction<double>(1., 1.));
+  }
+}
+
+template <typename T>
+void SetClosedGripperOrientation(const drake::multibody::MultibodyPlant<T>& plant,
+    drake::systems::Context<T>* context, const Eigen::Vector4d& q_wxyz) {
+  if (!q_wxyz.allFinite() || std::abs(q_wxyz.norm() - 1.) > 1e-3)
+    throw std::runtime_error("Invalid measured hand orientation");
+  const auto& frame = dynamic_cast<const drake::multibody::FixedOffsetFrame<T>&>(
+      plant.GetFrameByName("closed_gripper_orientation"));
+  Eigen::Quaterniond q(q_wxyz[0], q_wxyz[1], q_wxyz[2], q_wxyz[3]);
+  drake::math::RigidTransform<double> X(drake::math::RotationMatrix<double>(q.normalized()),
+                                      Eigen::Vector3d::Zero());
+  frame.SetPoseInParentFrame(context, X.template cast<T>());
+}
+}  // namespace dairlib
