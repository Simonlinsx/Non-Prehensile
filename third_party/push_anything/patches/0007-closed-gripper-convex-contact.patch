+void FrankaKinematics::ComputeHandOrientation(
+    const Context<double>& context, BasicVector<double>* output) const {
+  const auto* measured = dynamic_cast<const OutputVector<double>*>(
+      this->EvalVectorInput(context, franka_state_port_));
+  multibody::SetPositionsIfNew<double>(franka_plant_, measured->GetPositions(), franka_context_);
+  // Packaged Franka hand joint is -pi/4 about link8; link7->link8 has no rotation.
+  const auto R = franka_plant_.EvalBodyPoseInWorld(*franka_context_,
+      franka_plant_.GetBodyByName("panda_link7")).rotation() *
+      drake::math::RotationMatrix<double>::MakeZRotation(-0.785398163397);
+  const auto q = R.ToQuaternion();
+  output->SetFromVector(Eigen::Vector4d(q.w(), q.x(), q.y(), q.z()));
 }
 
