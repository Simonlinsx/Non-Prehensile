diff --git a/systems/controllers/foh_pd_rollout.h b/systems/controllers/foh_pd_rollout.h
new file mode 100644
--- /dev/null
+++ b/systems/controllers/foh_pd_rollout.h
@@ -0,0 +1,73 @@
+#pragma once
+
+#include <cmath>
+#include <stdexcept>
+#include <utility>
+#include <vector>
+#include <Eigen/Core>
+
+namespace dairlib {
+
+// Roll out the same FOH position/force references used by the Isaac LCM relay.
+// Only N state knots are published; x_plan[N] is an unexecuted LCS extension.
+// Hold the last published knot (zero reference velocity) over the final step.
+// Keep measured x[0] intact even when the desired right derivative is nonzero.
+// The injected transition is the existing fine LCS, not a new contact solver.
+template <typename Simulate>
+std::pair<std::vector<Eigen::VectorXd>, std::vector<Eigen::VectorXd>>
+SimulateFOHPDRollout(const std::vector<Eigen::VectorXd>& x_plan,
+                     const std::vector<Eigen::VectorXd>& u_plan,
+                     const Eigen::VectorXd& kp, const Eigen::VectorXd& kd,
+                     int ee_velocity_index, double dt, int rate,
+                     bool use_feedforward, const Simulate& simulate) {
+  using Eigen::VectorXd;
+  const int N = static_cast<int>(u_plan.size());
+  if (N < 1 || x_plan.size() != u_plan.size() + 1 || rate < 1 ||
+      !std::isfinite(dt) || dt <= 0 || ee_velocity_index < 3 ||
+      kp.size() != kd.size() || kp.size() < ee_velocity_index + 3 ||
+      !kp.allFinite() || !kd.allFinite()) {
+    throw std::invalid_argument("Invalid FOH PD rollout dimensions or timing");
+  }
+  for (const auto& x : x_plan) {
+    if (x.size() != kp.size() || !x.allFinite())
+      throw std::invalid_argument("Invalid FOH PD state knot");
+  }
+  for (const auto& u : u_plan) {
+    if (u.size() != 3 || !u.allFinite())
+      throw std::invalid_argument("Invalid FOH PD force knot");
+  }
+  for (int i = 0; i < kp.size(); ++i) {
+    if ((i >= 3 && kp[i] != 0) ||
+        ((i < ee_velocity_index || i >= ee_velocity_index + 3) && kd[i] != 0))
+      throw std::invalid_argument("FOH PD gains must actuate only EE position/velocity");
+  }
+  std::vector<VectorXd> x_coarse, u_coarse;
+  x_coarse.reserve(N + 1);
+  u_coarse.reserve(N);
+  VectorXd x = x_plan.front();
+  for (int i = 0; i < N * rate; ++i) {
+    const int left = i / rate;
+    const int right = left + 1 < N ? left + 1 : left;
+    const double alpha = static_cast<double>(i % rate) / rate;
+    const Eigen::Vector3d position =
+        (1 - alpha) * x_plan[left].head<3>() + alpha * x_plan[right].head<3>();
+    const Eigen::Vector3d velocity =
+        (x_plan[right].head<3>() - x_plan[left].head<3>()) / dt;
+    VectorXd u = kp.head<3>().cwiseProduct(position - x.head<3>()) +
+        kd.segment<3>(ee_velocity_index).cwiseProduct(
+            velocity - x.segment<3>(ee_velocity_index));
+    if (use_feedforward)
+      u += (1 - alpha) * u_plan[left] + alpha * u_plan[right];
+    if (i % rate == 0) {
+      x_coarse.push_back(x);
+      u_coarse.push_back(u);
+    }
+    x = simulate(x, u);
+    if (x.size() != kp.size() || !x.allFinite())
+      throw std::runtime_error("Nonfinite or invalid FOH PD simulated state");
+  }
+  x_coarse.push_back(x);
+  return {x_coarse, u_coarse};
+}
+
+}  // namespace dairlib
